# PostgreSQL connection string (Neon / Supabase / local)
DATABASE_URL=

# ── Auth.js (NextAuth v5) ──
# Generate with: openssl rand -base64 33
AUTH_SECRET=
# Required when self-hosting / behind a reverse proxy or Docker
AUTH_TRUST_HOST=true
# Canonical app origin (dev: http://localhost:3000)
AUTH_URL=http://localhost:3000

# ── Gemini (Google AI) ──
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── Fonnte (WhatsApp Gateway) ──
# Get yours at: https://fonnte.com (Dashboard → Device → Copy Token)
FONNTE_TOKEN=

# ── Cron Protection (optional) ──
# Used to secure the /api/cron/reminders endpoint in production
CRON_SECRET=
